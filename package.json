{
  "name": "@atul-shaw/ship-check",
  "version": "0.2.0",
  "description": "Pre-launch checklist runner for vibe-coded MERN apps",
  "type": "module",
  "bin": {
    "ship-check": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "find-repos": "node scripts/find-repos.mjs",
    "scan": "node scripts/scan-repos.mjs",
    "publish:github": "node scripts/publish-github.mjs"
  },
  "keywords": [
    "security",
    "checklist",
    "pre-launch",
    "mern",
    "express",
    "mongoose",
    "stripe",
    "razorpay",
    "vibe-coding",
    "static-analysis",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atul8108/check-list-tool.git"
  },
  "homepage": "https://github.com/Atul8108/check-list-tool#readme",
  "bugs": {
    "url": "https://github.com/Atul8108/check-list-tool/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^5.0.3"
  },
  "author": "Atul Shaw",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
